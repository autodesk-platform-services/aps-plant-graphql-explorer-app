<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\launch.ico</ApplicationIcon>
    <Version>1.0.5</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\launch.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3590-prerelease" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Configuration.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Configuration.settings</DependentUpon>
    </Compile>
    <Compile Update="ConfigurationStg.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>ConfigurationStg.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Configuration.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Configuration.Designer.cs</LastGenOutput>
    </None>
    <None Update="ConfigurationStg.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>ConfigurationStg.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <!--<ItemGroup>
    <PackageReference Include="Duende.IdentityModel" Version="7.1.0" />
  </ItemGroup>-->
</Project>
