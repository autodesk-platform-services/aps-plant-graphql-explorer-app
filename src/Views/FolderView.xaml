<local:BaseView x:Class="GraphQLClient.Views.FolderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GraphQLClient.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <local:BaseView.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </local:BaseView.Resources>
    <Grid>
        <TreeView x:Name="folders" 
                  ItemsSource="{Binding Folders}"
                  MouseDoubleClick="folders_MouseDoubleClick">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Height="16"
                                   Width="16"
                                   Margin="0,0,6,0"
                                   Fill="{Binding ProjectIconBrush}"
                                   ToolTip="{Binding Notification}">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlantProject}" Value="False">
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="pack://application:,,,/Resources/project.tif" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <TextBlock Text="{Binding Name}" Tag="{Binding Id}" FontSize="14"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <Border Grid.RowSpan="2"
                Background="#99000000"
                Height="50"
                Width="200"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                IsHitTestVisible="True">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="220"
                        Background="#CCFFFFFF">
                <StackPanel.Effect>
                    <DropShadowEffect BlurRadius="12"
                                      ShadowDepth="4"
                                      Opacity="0.35" />
                </StackPanel.Effect>
                <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,12" />
                <TextBlock Text="Loading results..."
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</local:BaseView>
