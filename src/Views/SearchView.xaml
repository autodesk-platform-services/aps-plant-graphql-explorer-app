<local:BaseView x:Class="GraphQLClient.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GraphQLClient.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="680">
    <local:BaseView.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <SolidColorBrush x:Key="SearchResultsHeaderBackgroundBrush" Color="#EDF3FF" />
        <SolidColorBrush x:Key="SearchResultsHeaderBorderBrush" Color="#C6D4F2" />
        <SolidColorBrush x:Key="SearchResultsRowHoverBrush" Color="#EEF3FF" />
        <SolidColorBrush x:Key="SearchResultsRowSelectedBrush" Color="#DCE4FF" />
        <SolidColorBrush x:Key="SearchResultsRowAlternateBrush" Color="#F8FAFD" />

        <Style x:Key="SearchResultsColumnHeaderGripperStyle" TargetType="Thumb">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,2,-4,2" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}">
                            <Rectangle Width="1"
                                       HorizontalAlignment="Center"
                                       Fill="{Binding SeparatorBrush, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22000000" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchResultsColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SearchResultsHeaderBackgroundBrush}" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="{StaticResource SearchResultsHeaderBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Style.Triggers>
                <Trigger Property="SortDirection" Value="Ascending">
                    <Setter Property="Background" Value="#DAE6FF" />
                </Trigger>
                <Trigger Property="SortDirection" Value="Descending">
                    <Setter Property="Background" Value="#CEDCFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchResultsRowStyle" TargetType="DataGridRow">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#2F3944" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{StaticResource SearchResultsRowAlternateBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SearchResultsRowHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SearchResultsRowSelectedBrush}" />
                    <Setter Property="Foreground" Value="#111827" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchResultsCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#2F3944" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#111827" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <CollectionViewSource x:Key="schemaGroups" Source="{Binding SchemaGroups}" />
    </local:BaseView.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Plant 3D references:"
                   FontSize="12"
                   Margin="10" />

            <!--<Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>-->

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" x:Name="leftColumn" />
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ComboBox x:Name="referenceCombobox" 
                              Grid.Row="0"
                              SelectedIndex="-1"
                              Margin="10"
                              SelectionChanged="referenceCombobox_SelectionChanged"
                              Background="White"
                              BorderBrush="#CCC"
                              BorderThickness="1"
                              Padding="5">
                        <ComboBox.ItemsSource>
                            <CompositeCollection>
                                <ComboBoxItem Content="Example Queries"/>
                                <Separator Height="3" Background="Gray" Margin="0,5"/>
                                <ComboBoxItem Content="All"/>
                                <Separator Height="3" Background="Gray" Margin="0,5"/>
                                <CollectionContainer Collection="{Binding Source={StaticResource schemaGroups}}"/>
                            </CompositeCollection>
                        </ComboBox.ItemsSource>
                    </ComboBox>


                    <ListBox x:Name="schemaList" Grid.Row="1"
                         VerticalAlignment="Stretch"
                         Margin="10,0,10,10">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="ToolTip" Value="Double-click to append to the query box"/>
                                <Setter Property="Content" Value="{Binding Key}"/>
                                <Setter Property="Tag" Value="{Binding Value}"/>
                                <EventSetter Event="MouseDoubleClick" Handler="SchemaList_MouseDoubleClick"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4*" />
                        <RowDefinition Height="6*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Query:" Margin="10" FontSize="12" Grid.Column="0" VerticalAlignment="Bottom"/>
                            <TextBlock Text="Scope:" Margin="10" FontSize="12" Grid.Column="1" VerticalAlignment="Bottom"/>
                            <ComboBox x:Name="partTypeCombobox"
                                  Grid.Column="2"
                                  HorizontalAlignment="Right"
                                  Width="122" Height="25" Margin="10"
                                  SelectionChanged="partTypeCombobox_SelectionChanged" 
                                  HorizontalContentAlignment="Center"
                                  Background="White"
                                  BorderBrush="#CCC"
                                  BorderThickness="1"
                                  Padding="5"
                                  SelectedIndex="-1">
                                    <ComboBoxItem Content="3D Model"/>
                                    <ComboBoxItem Content="P&amp;ID"/>
                            </ComboBox>
                        </Grid>

                        <RichTextBox x:Name="searchTextBox"
                          Grid.Row="1"
                          Margin="10, 0, 10, 10"
                          MinHeight="50"
                          Background="#F9FBFF"
                          BorderBrush="#C6D4F2"
                          BorderThickness="1"
                          AcceptsReturn="True"
                          AcceptsTab="True"
                          HorizontalContentAlignment="Left"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          TextChanged="searchTextBox_TextChanged"
                          PreviewKeyDown="searchTextBox_PreviewKeyDown"
                          LostKeyboardFocus="searchTextBox_LostKeyboardFocus">
                        </RichTextBox>
                        <Popup x:Name="suggestionsPopup"
                        PlacementTarget="{Binding ElementName=searchTextBox}"
                        Placement="Bottom"
                        StaysOpen="False"
                        AllowsTransparency="True"
                        IsOpen="{Binding IsSuggestionsOpen, Mode=TwoWay}"
                        PopupAnimation="Fade">
                            <Border Background="White"
                             BorderBrush="#C6D4F2"
                             BorderThickness="1"
                             CornerRadius="6"
                             Padding="4"
                             MaxHeight="220"
                             SnapsToDevicePixels="True">
                                <ListBox x:Name="suggestionsListBox"
                                  ItemsSource="{Binding FilteredSuggestions}"
                                  Width="{Binding Source={x:Reference searchTextBox}, Path=ActualWidth}"
                                  MaxHeight="200"
                                  MouseLeftButtonUp="suggestionsListBox_PreviewMouseLeftButtonUp"
                                  PreviewKeyDown="suggestionsListBox_PreviewKeyDown">
                                    <ListBox.Resources>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="8,4" />
                                        </Style>
                                    </ListBox.Resources>
                                </ListBox>
                            </Border>
                        </Popup>

                        <Button
                        Grid.Row="2"
                        Margin="10, 0, 10, 10" 
                        Content="Run" 
                        HorizontalAlignment="Right"
                        Width="122" Height="25" 
                        Background="#0696D7"
                        Foreground="White"
                        Click="SearchButton_Click" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Border Grid.Row="1"
                            Margin="10, 20, 10, 10"
                            Background="White">
                            <DataGrid x:Name="resultsDataGrid"
                              Margin="0"
                              MinHeight="200"
                              AutoGenerateColumns="True"
                              AlternationCount="2"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E4E7EB"
                              IsReadOnly="True"
                              ColumnWidth="Auto"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeColumns="True"
                              CanUserResizeRows="False"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              EnableRowVirtualization="True"
                              VirtualizingStackPanel.IsVirtualizing="True" 
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              RowStyle="{StaticResource SearchResultsRowStyle}"
                              CellStyle="{StaticResource SearchResultsCellStyle}"
                              ColumnHeaderStyle="{StaticResource SearchResultsColumnHeaderStyle}" />
                        </Border>

                        <Border Grid.Row="1"
                            Background="#99000000"
                            Height="50"
                            Width="200"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            IsHitTestVisible="True">
                            <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="220"
                            Background="#CCFFFFFF">
                                <StackPanel.Effect>
                                    <DropShadowEffect BlurRadius="12"
                                          ShadowDepth="4"
                                          Opacity="0.35" />
                                </StackPanel.Effect>
                                <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,12" />
                                <TextBlock Text="Loading results..."
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!--<DockPanel Grid.Row="1">
                <Button Content="&lt;&lt; Choose project"
                    Margin="10"
                    DockPanel.Dock="Left"
                    Style="{StaticResource OutlineButtonStyle}"
                    Width="138"
                    Click="ChooseProject_Click"/>
                <Button 
                    Margin="10" 
                    Content="Export CSV"
                    Style="{StaticResource OutlineButtonStyle}"
                    Width="122"
                    DockPanel.Dock="Right"
                    Click="ExportButton_Click" />
                <Grid/>
            </DockPanel>-->
    </Grid>

</local:BaseView>
