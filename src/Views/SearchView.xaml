<local:BaseView x:Class="GraphQLClient.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GraphQLClient.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="680">
    <local:BaseView.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <SolidColorBrush x:Key="SearchResultsHeaderBackgroundBrush" Color="#EDF3FF" />
        <SolidColorBrush x:Key="SearchResultsHeaderBorderBrush" Color="#C6D4F2" />
        <SolidColorBrush x:Key="SearchResultsRowHoverBrush" Color="#EEF3FF" />
        <SolidColorBrush x:Key="SearchResultsRowSelectedBrush" Color="#DCE4FF" />
        <SolidColorBrush x:Key="SearchResultsRowAlternateBrush" Color="#F8FAFD" />

        <Style x:Key="SearchResultsColumnHeaderGripperStyle" TargetType="Thumb">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,2,-4,2" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}">
                            <Rectangle Width="1"
                                       HorizontalAlignment="Center"
                                       Fill="{Binding SeparatorBrush, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22000000" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchResultsColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SearchResultsHeaderBackgroundBrush}" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="{StaticResource SearchResultsHeaderBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Style.Triggers>
                <Trigger Property="SortDirection" Value="Ascending">
                    <Setter Property="Background" Value="#DAE6FF" />
                </Trigger>
                <Trigger Property="SortDirection" Value="Descending">
                    <Setter Property="Background" Value="#CEDCFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchResultsRowStyle" TargetType="DataGridRow">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#2F3944" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{StaticResource SearchResultsRowAlternateBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SearchResultsRowHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SearchResultsRowSelectedBrush}" />
                    <Setter Property="Foreground" Value="#111827" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchResultsCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#2F3944" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#111827" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </local:BaseView.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Plant 3D references:"
                   FontSize="12"
                   Margin="10" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" x:Name="leftColumn" />
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ComboBox Name="referenceCombobox" Grid.Row="0"
                           Margin="10">
                            <ComboBoxItem Content="Reference 1" />
                            <ComboBoxItem Content="Reference 2" />
                            <ComboBoxItem Content="Reference 3" />
                     </ComboBox>


                    <ListBox x:Name="schemaList" Grid.Row="1"
                         VerticalAlignment="Stretch"
                         Margin="10,0,10,10" />
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4*" />
                        <RowDefinition Height="6*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Query:" Margin="10" FontSize="12" Grid.Column="0"/>
                            <TextBlock Text="Scope:" Margin="10" FontSize="12" Grid.Column="1"/>
                            <ComboBox x:Name="partTypeCombobox"
                          Grid.Column="2"
                          HorizontalAlignment="Right"
                          Width="100" Height="25" Margin="10"
                          SelectionChanged="partTypeCombobox_SelectionChanged" 
                          HorizontalContentAlignment="Center"
                          SelectedIndex="-1">
                                <ComboBoxItem Content="ProcessPower"/>
                                <ComboBoxItem Content="Piping"/>
                            </ComboBox>
                        </Grid>

                        <RichTextBox x:Name="searchTextBox"
                          Grid.Row="1"
                          Margin="10, 0, 10, 10"
                          FontFamily="Segoe UI"
                          FontSize="13"
                          Foreground="#1F2937"
                          Background="#F9FBFF"
                          BorderBrush="#C6D4F2"
                          BorderThickness="1"
                          AcceptsReturn="True"
                          AcceptsTab="True"
                          HorizontalContentAlignment="Left"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          SpellCheck.IsEnabled="True"
                          TextChanged="searchTextBox_TextChanged"
                          PreviewKeyDown="searchTextBox_PreviewKeyDown"
                          LostKeyboardFocus="searchTextBox_LostKeyboardFocus">
                            <RichTextBox.Resources>
                                <Style TargetType="FlowDocument">
                                    <Setter Property="PagePadding" Value="0" />
                                    <Setter Property="LineHeight" Value="3" />
                                </Style>
                                <Style TargetType="Paragraph">
                                    <Setter Property="Margin" Value="0" />
                                </Style>
                            </RichTextBox.Resources>
                        </RichTextBox>
                        <Popup x:Name="suggestionsPopup"
                        PlacementTarget="{Binding ElementName=searchTextBox}"
                        Placement="Bottom"
                        StaysOpen="False"
                        AllowsTransparency="True"
                        IsOpen="{Binding IsSuggestionsOpen, Mode=TwoWay}"
                        PopupAnimation="Fade">
                            <Border Background="White"
                             BorderBrush="#C6D4F2"
                             BorderThickness="1"
                             CornerRadius="6"
                             Padding="4"
                             MaxHeight="220"
                             SnapsToDevicePixels="True">
                                <ListBox x:Name="suggestionsListBox"
                                  ItemsSource="{Binding FilteredSuggestions}"
                                  Width="{Binding Source={x:Reference searchTextBox}, Path=ActualWidth}"
                                  MaxHeight="200"
                                  MouseLeftButtonUp="suggestionsListBox_PreviewMouseLeftButtonUp"
                                  PreviewKeyDown="suggestionsListBox_PreviewKeyDown">
                                    <ListBox.Resources>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="8,4" />
                                        </Style>
                                    </ListBox.Resources>
                                </ListBox>
                            </Border>
                        </Popup>

                        <Button
                        Grid.Row="2"
                        Margin="10, 0, 10, 10" 
                        Content="Search" 
                        HorizontalAlignment="Right"
                        Width="100" Height="25" 
                        Click="SearchButton_Click" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Border Grid.Row="1"
                        Margin="10, 20, 10, 10"
                        Background="White">

                            <DataGrid x:Name="resultsDataGrid"
                              Margin="0"
                              AutoGenerateColumns="True"
                              AlternationCount="2"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E4E7EB"
                              IsReadOnly="True"
                              ColumnWidth="Auto"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeColumns="True"
                              CanUserResizeRows="False"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              EnableRowVirtualization="True"
                              VirtualizingStackPanel.IsVirtualizing="True" 
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              RowStyle="{StaticResource SearchResultsRowStyle}"
                              CellStyle="{StaticResource SearchResultsCellStyle}"
                              ColumnHeaderStyle="{StaticResource SearchResultsColumnHeaderStyle}" />
                        </Border>

                        <Border Grid.Row="1"
                        Background="#99000000"
                        Height="50"
                        Width="200"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                        IsHitTestVisible="True">
                            <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="220"
                            Background="#CCFFFFFF">
                                <StackPanel.Effect>
                                    <DropShadowEffect BlurRadius="12"
                                          ShadowDepth="4"
                                          Opacity="0.35" />
                                </StackPanel.Effect>
                                <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,12" />
                                <TextBlock Text="Loading results..."
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Grid Grid.Row="1">
                <Button Content="&lt;&lt; Choose project"
                    Margin="10"
                    HorizontalAlignment="Left"
                    Width="150" Height="25"/>
                <Button 
                    Margin="10" 
                    Content="Export CSV"
                    Width="100" Height="25"
                    HorizontalAlignment="Right"
                    Click="ExportButton_Click" />
            </Grid>
        </Grid>
    </Grid>

