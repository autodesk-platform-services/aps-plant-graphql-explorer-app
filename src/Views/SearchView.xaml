<local:BaseView x:Class="GraphQLClient.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GraphQLClient.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <local:BaseView.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <SolidColorBrush x:Key="SearchResultsHeaderBackgroundBrush" Color="#EDF3FF" />
        <SolidColorBrush x:Key="SearchResultsHeaderBorderBrush" Color="#C6D4F2" />
        <SolidColorBrush x:Key="SearchResultsRowHoverBrush" Color="#EEF3FF" />
        <SolidColorBrush x:Key="SearchResultsRowSelectedBrush" Color="#DCE4FF" />
        <SolidColorBrush x:Key="SearchResultsRowAlternateBrush" Color="#F8FAFD" />

        <Style x:Key="SearchResultsColumnHeaderGripperStyle" TargetType="Thumb">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,2,-4,2" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}">
                            <Rectangle Width="1"
                                       HorizontalAlignment="Center"
                                       Fill="{Binding SeparatorBrush, RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22000000" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchResultsColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SearchResultsHeaderBackgroundBrush}" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="{StaticResource SearchResultsHeaderBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Style.Triggers>
                <Trigger Property="SortDirection" Value="Ascending">
                    <Setter Property="Background" Value="#DAE6FF" />
                </Trigger>
                <Trigger Property="SortDirection" Value="Descending">
                    <Setter Property="Background" Value="#CEDCFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchResultsRowStyle" TargetType="DataGridRow">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#2F3944" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{StaticResource SearchResultsRowAlternateBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SearchResultsRowHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SearchResultsRowSelectedBrush}" />
                    <Setter Property="Foreground" Value="#111827" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchResultsCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#2F3944" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#111827" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </local:BaseView.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,10,0,10">
            <ComboBox x:Name="partTypeCombobox"
                  Width="150" Height="25"
                  SelectionChanged="partTypeCombobox_SelectionChanged" 
                  SelectedIndex="-1">
                <ComboBoxItem Content="ProcessPower" />
                <ComboBoxItem Content="Piping" />
            </ComboBox>
            
            <TextBox x:Name="searchTextBox" Width="400" Height="25" Margin="50,0,10,0" />
            <Button Content="Search" Width="75" Height="25" Click="SearchButton_Click" />
            <Button Content="Export CSV"
                    Width="90"
                    Height="25"
                    Margin="10,0,0,0"
                    Click="ExportButton_Click" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="10"
                Background="White"
                CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16"
                                  ShadowDepth="2"
                                  Opacity="0.18" />
            </Border.Effect>
            <DataGrid x:Name="resultsDataGrid"
                      Margin="0"
                      AutoGenerateColumns="True"
                      AlternationCount="2"
                      HeadersVisibility="Column"
                      Background="Transparent"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E4E7EB"
                      IsReadOnly="True"
                      ColumnWidth="Auto"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeColumns="True"
                      CanUserResizeRows="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      EnableRowVirtualization="True"
                      VirtualizingStackPanel.IsVirtualizing="True" 
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      RowStyle="{StaticResource SearchResultsRowStyle}"
                      CellStyle="{StaticResource SearchResultsCellStyle}"
                      ColumnHeaderStyle="{StaticResource SearchResultsColumnHeaderStyle}" />
        </Border>

        <Border Grid.RowSpan="2"
                Background="#99000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                IsHitTestVisible="True">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="220"
                        Background="#CCFFFFFF">
                <StackPanel.Effect>
                    <DropShadowEffect BlurRadius="12"
                                      ShadowDepth="4"
                                      Opacity="0.35" />
                </StackPanel.Effect>
                <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,12" />
                <TextBlock Text="Loading results..."
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</local:BaseView>
