                        <TabItem Header="OAuth (with PKCE)">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch">
                                <Grid Margin="0 0 0 4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Client ID:" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                         x:Name="ClientIdPKCETextBox"
                                         IsReadOnly="True"
                                         Background="LightGray"
                                         HorizontalAlignment="Stretch"
                                         Height="24"
                                         Margin="8 0 0 0"
                                         Text="" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Callback URL:" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                         x:Name="CallbackPKCEUrlTextBox"
                                         IsReadOnly="True"
                                         Background="LightGray"
                                         Height="24"
                                         Margin="8 0 0 0"
                                         Text="" />
                                </Grid>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                     
                 </Border>
            </StackPanel>

            <ProgressBar x:Name="LoginProgressBar"
                         Grid.Column="1"
                         Margin="16 0 0 0"
                         Width="68"
                         Height="8"
                         VerticalAlignment="Center"
                         Visibility="Collapsed"
                         IsIndeterminate="True" />
        </Grid>

        <TextBlock x:Name="StatusTextBlock"
                   Text=""
                   FontSize="12"
                   Foreground="#FF2D74DA"
                   TextWrapping="Wrap"
                   AutomationProperties.Name="Status message" />
    </StackPanel>
</UserControl>


