<Window x:Class="GraphQLClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:GraphQLClient.Views"
        mc:Ignorable="d"
        Title="GraphQL Client" Height="420" Width="420"
        MinHeight="360" MinWidth="360"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="1"
                Margin="24"
                Padding="28"
                CornerRadius="12"
                Background="White"
                BorderBrush="#FFDFE3E8"
                BorderThickness="1">
            <Grid>
                <views:LoginView x:Name="LoginViewControl" Visibility="Visible" />
            </Grid>
        </Border>
    </Grid>
</Window>
