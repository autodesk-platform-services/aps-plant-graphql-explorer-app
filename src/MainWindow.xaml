<Window x:Class="GraphQLClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:GraphQLClient.Views"
        mc:Ignorable="d"
        Title="GraphQL Client"
        Height="600" Width="1000"
        MinHeight="100" MinWidth="300"
        Icon="/Resources/launch.ico"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height"
        Loaded="Window_Loaded">
    <Grid Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Margin="24,24,24,24"
                Padding="28"
                CornerRadius="12"
                Background="White"
                BorderBrush="#FFDFE3E8"
                BorderThickness="1">
            <Grid>
                <views:LoginView x:Name="LoginViewControl" Visibility="Visible" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
