{
  "Examples": [
    {
      "Title": "Query valves in project (P&ID)",
      "Scope": "PID",
      "Project": "General (any project)",
      "Script": "property.id.autodesk.plant3d.parameter:tableNames-1.0.0=contains='HandValves'"
    },
    {
      "Title": "Query valves in project (3D)",
      "Scope": "P3D",
      "Project": "General (any project)",
      "Script": "property.id.autodesk.plant3d.parameter:tableNames-1.0.0=contains='Valve'"
