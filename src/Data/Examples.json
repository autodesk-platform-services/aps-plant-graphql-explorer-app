    },
    {
      "Title": "Query valves per DWG, stage 2 of 3 (P&ID)",
      "Scope": "PID",
      "Project": "General (any project) — requires a real dwgId",
      "Script": "property.id.autodesk.plant3d.parameter:tableNames-1.0.0=contains='PnPDataLinks' and property.id.autodesk.plant3d.parameter:dwgId-1.0.0==1275 and property.id.autodesk.plant3d.parameter:rowClassName-1.0.0=='GateValve'"
    },
    {
      "Title": "Query line numbers by spec prefix (P&ID)",
      "Scope": "PID",
      "Project": "General (any project) — edit the spec prefix",
      "Script": "property.id.autodesk.plant3d.parameter:tableNames-1.0.0=contains='Primary' and property.id.autodesk.plant3d.parameter:tag-1.0.0=contains='4\"-CS300-P-'"
    },
    {
      "Title": "Query a custom property (edit hubId + property id)",
      "Scope": "PID",
      "Project": "General (any project) — requires exact custom property id",
      "Script": "property.id.parameters.YOUR_HUB_ID:yourpropertyname_double-1.0.0=='value'"
    },
    {
      "Title": "Query pipes by line number (3D)",
      "Scope": "P3D",
      "Project": "General (any project) — edit the line number",
      "Script": "property.id.autodesk.plant3d.parameter:tableNames-1.0.0=contains='Pipe,' and property.id.autodesk.plant3d.parameter:lineNumberTag-1.0.0=contains='1009'"
    },
